[Unit]
Description=Story Stack audiobook Store and personal library
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/story-stack
Environment=NODE_ENV=production
Environment=PORT=4100
Environment=HOST=0.0.0.0
Environment=STORY_STACK_DATA_DIR=/var/lib/story-stack
Environment=STORY_STACK_LIBRARY_PATH=/srv/media/audiobooks/
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
